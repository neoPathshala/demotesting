{
  "name": "neocsit-admin-portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack -p 3000",
    "build": "next build --webpack",
    "start": "next start -p 3000",
    "postinstall": "prisma generate",
    "typecheck": "next typegen && tsc --noEmit --incremental false",
    "test": "node --test tests/*.test.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "admin:create": "node scripts/create-admin.mjs",
    "db:setup": "prisma migrate deploy && prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@radix-ui/react-slot": "^1.5.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.59.0",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.1.7",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "postcss": "^8.5.30",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5"
  },
  "engines": {
    "node": "22.x"
  }
}
